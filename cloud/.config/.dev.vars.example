# Cloudflare Workers Configuration
# Copy this file to .dev.vars and fill in your actual values

# Cloudflare Account ID (found in Dashboard)
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# Cloudflare API Token (with Workers Scripts and R2 edit permissions)
# Create at: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your_api_token_here

# R2 Bucket Name
R2_BUCKET_NAME=your_bucket_name_here

# GPX変換で処理する対象日数（デフォルト: 3日）
# 0または未設定の場合は全データを処理
CONVERSION_DAYS=3

# Optional: Cron secret for scheduled triggers
CRON_SECRET=your_secret_here

# Pages Function URL for scheduler worker
PAGES_FUNCTION_URL=https://<your-project-name>.gpx-converter.pages.dev/gpx-converter

# Scheduler Worker URL for manual triggering (optional)
SCHEDULER_WORKER_URL=https://gpx-converter-scheduler.<your-account>.workers.dev
