# Cloudflare Workers Configuration
# Copy this file to .dev.vars and fill in your actual values
# DO NOT commit .dev.vars to version control

# Your Cloudflare Account ID
# Find this in Cloudflare dashboard: https://dash.cloudflare.com/ -> Workers & Pages -> Account ID
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# R2 Bucket Name (should match wrangler.toml)
R2_BUCKET_NAME=your_backet_name_here