# M5Stack GNSS Logger Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit this file to version control

# WiFi Configuration
# The SSID of the WiFi network to connect to for uploading data
WIFI_SSID=your_wifi_ssid
WIFI_PASSWORD=your_wifi_password

# R2 Configuration
# Your Cloudflare Account ID
R2_ACCOUNT_ID=your_account_id_here

# R2 Bucket Name
R2_BUCKET_NAME=your_bucket_name_here

# R2 Access Credentials
# Create these in Cloudflare Dashboard: R2 → Manage R2 API Tokens
R2_ACCESS_KEY=your_access_key_here
R2_SECRET_KEY=your_secret_key_here

# R2 Region (usually 'auto' for Cloudflare R2)
R2_REGION=auto

# R2 Endpoint (will be constructed automatically)
# Format: https://<account_id>.r2.cloudflarestorage.com
# R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com