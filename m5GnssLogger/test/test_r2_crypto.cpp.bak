// Test for R2 crypto operations
// This tests the SHA256 and HMAC-SHA256 functions

// Use the real mbedtls library for native testing
#include <mbedtls/sha256.h>
#include <mbedtls/md.h>
#include <cstring>

#include <unity.h>

// Include all mocks FIRST (before any project headers)
#include "native/mocks/mock_arduino.h"
#include "native/mocks/mock_m5core2.h"
#include "native/mocks/mock_display.h"

// Define the displayModule instance for the linker
DisplayModule displayModule;

// Now include R2 header
#include <r2.h>
#include <config.h>

// Include the R2 implementation (needs mocks to be available first)
#include "../src/r2.cpp"

// Test helper: Compute SHA256 using mbedtls directly for comparison
String computeSHA256(const char* data, size_t len) {
  unsigned char hash[32];
  mbedtls_sha256_context ctx;

  mbedtls_sha256_init(&ctx);
  mbedtls_sha256_starts(&ctx, 0);
  mbedtls_sha256_update(&ctx, (const unsigned char*)data, len);
  mbedtls_sha256_finish(&ctx, hash);
  mbedtls_sha256_free(&ctx);

  char hexHash[65];
  for (int i = 0; i < 32; i++) {
    sprintf(hexHash + (i * 2), "%02x", hash[i]);
  }
  hexHash[64] = '\0';

  return String(hexHash);
}

void setUp(void) {
  // Set up before each test
}

void tearDown(void) {
  // Clean up after each test
}

// Test 1: SHA256 of empty string (NIST test vector)
void test_sha256_empty_string(void) {
  R2Module r2;
  String result = r2._sha256("", 0);
  String expected = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855";

  TEST_ASSERT_EQUAL_STRING(expected.c_str(), result.c_str());
}

// Test 2: SHA256 of "abc" (NIST test vector)
void test_sha256_abc(void) {
  R2Module r2;
  String result = r2._sha256("abc", 3);
  String expected = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad";

  TEST_ASSERT_EQUAL_STRING(expected.c_str(), result.c_str());
}

// Test 3: SHA256 of longer string (NIST test vector)
void test_sha256_longer_string(void) {
  R2Module r2;
  const char* data = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq";
  String result = r2._sha256(data, strlen(data));
  String expected = "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1";

  TEST_ASSERT_EQUAL_STRING(expected.c_str(), result.c_str());
}

// Test 4: HMAC-SHA256 with RFC 4231 test case 1
void test_hmac_sha256_rfc4231_case1(void) {
  R2Module r2;

  // Key: 20 bytes of 0x0b
  const unsigned char key[20] = {
    0x0b, 0x0b, 0x0b, 0x0b, 0x0b, 0x0b, 0x0b, 0x0b, 0x0b, 0x0b,
    0x0b, 0x0b, 0x0b, 0x0b, 0x0b, 0x0b, 0x0b, 0x0b, 0x0b, 0x0b
  };
  const char* data = "Hi There";

  char output[65];
  r2._hmacSha256((const char*)key, 20, data, strlen(data), output);

  String expected = "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7";
  TEST_ASSERT_EQUAL_STRING(expected.c_str(), output);
}

// Test 5: HMAC-SHA256 with RFC 4231 test case 2
void test_hmac_sha256_rfc4231_case2(void) {
  R2Module r2;

  const char* key = "Jefe";
  const char* data = "what do ya want for nothing?";

  char output[65];
  r2._hmacSha256(key, strlen(key), data, strlen(data), output);

  String expected = "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843";
  TEST_ASSERT_EQUAL_STRING(expected.c_str(), output);
}

// Test 6: HMAC-SHA256 binary output
void test_hmac_sha256_binary_output(void) {
  R2Module r2;

  const char* key = "key";
  const char* data = "The quick brown fox jumps over the lazy dog";
  unsigned char output[32];

  r2._hmacSha256Binary(key, strlen(key), data, strlen(data), output);

  // Check that we got a valid hash (non-zero, consistent)
  bool allZero = true;
  for (int i = 0; i < 32; i++) {
    if (output[i] != 0) {
      allZero = false;
      break;
    }
  }
  TEST_ASSERT_FALSE(allZero);

  // Verify consistency - same input should give same output
  unsigned char output2[32];
  r2._hmacSha256Binary(key, strlen(key), data, strlen(data), output2);

  bool match = true;
  for (int i = 0; i < 32; i++) {
    if (output[i] != output2[i]) {
      match = false;
      break;
    }
  }
  TEST_ASSERT_TRUE(match);
}

// Test 7: Key derivation chain consistency
void test_key_derivation_chain_consistency(void) {
  R2Module r2;

  // AWS SigV4 key derivation test
  const char* secretKey = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY";
  const char* dateStamp = "20150830";
  const char* region = "us-east-1";
  const char* service = "s3";

  // kDate = HMAC("AWS4" + secretKey, dateStamp)
  String kSecret = "AWS4" + String(secretKey);
  unsigned char kDate[32];
  r2._hmacSha256Binary(kSecret.c_str(), kSecret.length(), dateStamp, strlen(dateStamp), kDate);

  // kRegion = HMAC(kDate, region)
  unsigned char kRegion[32];
  r2._hmacSha256Binary((const char*)kDate, 32, region, strlen(region), kRegion);

  // kService = HMAC(kRegion, service)
  unsigned char kService[32];
  r2._hmacSha256Binary((const char*)kRegion, 32, service, strlen(service), kService);

  // kSigning = HMAC(kService, "aws4_request")
  unsigned char kSigning[32];
  r2._hmacSha256Binary((const char*)kService, 32, "aws4_request", 12, kSigning);

  // Verify that the signing key is consistent
  unsigned char kSigning2[32];
  r2._hmacSha256Binary((const char*)kService, 32, "aws4_request", 12, kSigning2);

  bool match = true;
  for (int i = 0; i < 32; i++) {
    if (kSigning[i] != kSigning2[i]) {
      match = false;
      break;
    }
  }
  TEST_ASSERT_TRUE(match);
}

int main() {
  UNITY_BEGIN();

  RUN_TEST(test_sha256_empty_string);
  RUN_TEST(test_sha256_abc);
  RUN_TEST(test_sha256_longer_string);
  RUN_TEST(test_hmac_sha256_rfc4231_case1);
  RUN_TEST(test_hmac_sha256_rfc4231_case2);
  RUN_TEST(test_hmac_sha256_binary_output);
  RUN_TEST(test_key_derivation_chain_consistency);

  return UNITY_END();
}
