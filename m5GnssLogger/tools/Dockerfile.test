# Docker image for running PlatformIO unit tests
FROM ubuntu:22.04

# Install Python and PlatformIO dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    build-essential \
    git \
    libmbedtls-dev \
    && rm -rf /var/lib/apt/lists/*

# Install PlatformIO
RUN pip3 install platformio

# Verify PlatformIO is installed
RUN pio --version

# Set working directory
WORKDIR /workspace

# Default command runs tests
CMD ["pio", "test"]
